# --- Plume configuration ---
# Copy this file to ".env" and fill in your Azure app's Client ID.
# (Plume walks you through getting this in the README.)

# The "Application (client) ID" from your Azure app registration.
VITE_AZURE_CLIENT_ID=

# Who can sign in:
#   common        -> any Microsoft account (work, school, or personal)
#   organizations -> work/school accounts only (recommended for company email)
#   <tenant-id>   -> only your specific company
VITE_AZURE_AUTHORITY=organizations

# --- Agent layer (optional) ---
# The deployed Cloudflare worker that holds your Anthropic key and Notion
# token. Leave blank and Plume falls back to local heuristics: the Brief and
# Runway still work, just without Notion context or drafted replies.
#
# Nothing secret goes in this file — the worker holds both secrets, and the
# browser only ever sends it your Microsoft token. See worker/README.md.
VITE_AGENT_URL=
